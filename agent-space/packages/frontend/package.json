{
  "name": "@eclipse-che/agent-space-frontend",
  "version": "0.1.0",
  "description": "Agent Space MVP frontend - manage Kubernetes AgentSandbox resources",
  "private": true,
  "license": "EPL-2.0",
  "scripts": {
    "build": "webpack --config webpack.config.prod.js",
    "build:dev": "webpack --progress --color --config webpack.config.dev.js",
    "build:watch": "yarn build:dev --watch",
    "lint:check": "yarn stylelint && yarn eslint",
    "lint:fix": "yarn stylelint:fix && yarn eslint:fix",
    "format:check": "yarn prettier --config ../../../.prettierrc --check src/",
    "format:fix": "yarn prettier --config ../../../.prettierrc --write src/",
    "eslint": "tsc --noEmit && eslint '*/**/*.{ts,tsx}'",
    "eslint:fix": "tsc --noEmit && eslint '*/**/*.{ts,tsx}' --fix",
    "stylelint": "stylelint 'src/**/*.css' --allow-empty-input",
    "stylelint:fix": "stylelint 'src/**/*.css' --allow-empty-input --fix",
    "test": "jest",
    "test:coverage": "yarn test --coverage",
    "test:watch": "yarn test --watch"
  },
  "dependencies": {
    "@codemirror/lang-yaml": "^6.1.2",
    "@codemirror/language": "^6.10.8",
    "@codemirror/view": "^6.36.2",
    "@lezer/highlight": "^1.2.1",
    "@patternfly/react-core": "^6.4.0",
    "@patternfly/react-icons": "^6.4.0",
    "@patternfly/react-table": "^6.4.0",
    "@reduxjs/toolkit": "^2.2.7",
    "@uiw/codemirror-theme-github": "^4.25.4",
    "@uiw/react-codemirror": "4.23.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "axios": "^1.20.0",
    "detect-browser": "^5.3.0",
    "js-yaml": "^4.3.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.1.2",
    "react-router-dom": "^6.30.6",
    "redux-logger": "^3.0.6"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest": "^29.5.3",
    "@types/js-yaml": "^4.0.5",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "@types/redux-logger": "^3.0.13",
    "@typescript-eslint/eslint-plugin": "^6.4.0",
    "@typescript-eslint/parser": "^6.4.0",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^6.8.1",
    "css-minimizer-webpack-plugin": "^5.0.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-no-relative-import-paths": "^1.5.2",
    "eslint-plugin-notice": "^0.9.10",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-react": "^7.33.1",
    "eslint-plugin-react-hooks": "^4.2.0",
    "eslint-plugin-simple-import-sort": "^10.0.0",
    "html-webpack-plugin": "^5.5.3",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^29.6.4",
    "mini-css-extract-plugin": "^2.7.6",
    "prettier": "^3.2.5",
    "style-loader": "^3.3.3",
    "stylelint": "^16.15.0",
    "stylelint-config-clean-order": "^5.2.0",
    "stylelint-config-standard": "^34.0.0",
    "ts-jest": "^29.4.6",
    "ts-loader": "^9.4.4",
    "typescript": "^5.5.4",
    "webpack": "^5.104.1",
    "webpack-cli": "^5.1.4",
    "webpack-merge": "^5.9.0"
  },
  "sideEffects": [
    "*.css"
  ]
}
